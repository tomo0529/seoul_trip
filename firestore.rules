rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 回答：誰でも読める／4人の名前のドキュメントにだけ書き込める
    match /votes/{member} {
      allow read: if true;
      allow write: if member in ['takuya', 'kensan', 'takechan', 'ryohe']
        && request.resource.data.keys().hasOnly(['name', 'key', 'picks', 'memo', 'updatedAt'])
        && request.resource.data.picks is map
        && request.resource.data.memo is string
        && request.resource.data.memo.size() <= 1000;
      allow delete: if false;
    }

    // それ以外は全部拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
